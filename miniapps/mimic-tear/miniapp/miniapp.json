{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/",
    "window": {
      "width": 420,
      "height": 640,
      "minWidth": 320,
      "minHeight": 400,
      "resizable": true,
      "frame": false,
      "transparent": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "clickThrough": false
    }
  },
  "mcpEndpoints": [],
  "hostConnectorAccess": {
    "providers": []
  },
  "agentAccess": [
    "session.run",
    "session.read"
  ],
  "agentConcurrency": 4,
  "deviceAccess": [
    "microphone"
  ]
}
